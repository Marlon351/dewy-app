# Copy to .env for local development. In production, set these in Render instead.
PORT=3000

# MongoDB Atlas connection string, with <PASSWORD> where the password goes
DATABASE=mongodb+srv://<user>:<PASSWORD>@<cluster>.mongodb.net/dewy
DATABASE_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d
PASSWORD_WORK_FACTOR=12

# 64 hex characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up. If it's lost, encrypted routines and notes can't be read.
ENCRYPTION_KEY=

# Gmail address and a Gmail App Password (Google Account > Security > App passwords)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Set to 1 when running behind a proxy such as Render
TRUST_PROXY=
